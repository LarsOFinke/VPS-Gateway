# Origin-to-gateway deployment profile for the test target.
# Copy to .env.origin.test, chmod 600, and keep credentials outside this repo.
GATEWAY_DEPLOY_ENVIRONMENT=test
GATEWAY_DEPLOY_HOST=gateway-test.example.org
GATEWAY_DEPLOY_USER=gateway-admin
GATEWAY_DEPLOY_PORT=22
GATEWAY_DEPLOY_IDENTITY_FILE=
GATEWAY_RELEASE_SIGNING_KEY=
GATEWAY_DEPLOY_REMOTE_DIR=/var/lib/vps-gateway-deploy/test
GATEWAY_DEPLOY_INSTALL_ROOT=/srv/vps-gateway-test
