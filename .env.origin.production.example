# Origin-to-gateway deployment profile for the production target.
# Production is loaded only after the explicit --production flag.
GATEWAY_DEPLOY_ENVIRONMENT=production
GATEWAY_DEPLOY_HOST=gateway.example.org
GATEWAY_DEPLOY_USER=gateway-admin
GATEWAY_DEPLOY_PORT=22
GATEWAY_DEPLOY_IDENTITY_FILE=
GATEWAY_RELEASE_SIGNING_KEY=
GATEWAY_DEPLOY_REMOTE_DIR=/var/lib/vps-gateway-deploy/production
GATEWAY_DEPLOY_INSTALL_ROOT=/srv/vps-gateway
