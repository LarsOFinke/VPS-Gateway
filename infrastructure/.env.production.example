# VPS Gateway production runtime. Copy to .env.production; never commit it.
GATEWAY_ENVIRONMENT=production
COMPOSE_PROJECT_NAME=vps-gateway
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
GATEWAY_INGRESS_NETWORK=vps-ingress
GATEWAY_ROUTES_DIR=./.runtime/production/routes
LETSENCRYPT_EMAIL=admin@example.com
# Empty means the Let's Encrypt production directory.
GATEWAY_ACME_SERVER=
