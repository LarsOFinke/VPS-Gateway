# VPS Gateway test runtime. Copy to .env.test; never commit the private file.
GATEWAY_ENVIRONMENT=test
COMPOSE_PROJECT_NAME=vps-gateway-test
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18443
GATEWAY_INGRESS_NETWORK=vps-ingress-test
GATEWAY_ROUTES_DIR=./.runtime/test/routes
LETSENCRYPT_EMAIL=admin@example.com
# Certbot staging avoids production issuance limits during rehearsals.
GATEWAY_ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
