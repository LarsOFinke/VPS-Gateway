#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/target.sh"
gateway_select_target "$@"
gateway_strip_target_arguments "$@"
set -- "${GATEWAY_REMAINING_ARGS[@]}"
email=""
while (($#)); do
  case "$1" in
    --email) [[ $# -ge 2 ]] || { echo '[gateway] --email requires a value.' >&2; exit 2; }; email="$2"; shift 2 ;;
    *) echo 'usage: scripts/setup [--test|--production] --email ADDRESS' >&2; exit 2 ;;
  esac
done
[[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || {
  echo '[gateway] A valid certificate contact is required with --email.' >&2
  exit 2
}
gateway_require_root

for command in nginx certbot openssl systemctl flock; do
  command -v "$command" >/dev/null || {
    echo "[gateway] Missing command '$command'. Install nginx, certbot, and openssl first." >&2
    exit 1
  }
done

config_root=/etc/vps-gateway
sites_dir="$config_root/sites"
environment_file="$config_root/environment"
email_file="$config_root/letsencrypt-email"
nginx_config=/etc/nginx/conf.d/00-vps-gateway.conf
had_environment=false
if [[ -f "$environment_file" ]]; then
  had_environment=true
  installed="$(<"$environment_file")"
  [[ "$installed" == "$GATEWAY_TARGET" ]] || {
    echo "[gateway] Refusing to change this server from '$installed' to '$GATEWAY_TARGET'." >&2
    exit 2
  }
fi

install -d -m 0755 -o root -g root "$config_root" "$sites_dir" /var/www/letsencrypt \
  /etc/letsencrypt/renewal-hooks/deploy
install -m 0755 -o root -g root "$ROOT_DIR/config/certbot-deploy-hook.sh" \
  /etc/letsencrypt/renewal-hooks/deploy/vps-gateway-reload
if [[ ! -s "$config_root/default.crt" || ! -s "$config_root/default.key" ]]; then
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=unconfigured.invalid' -keyout "$config_root/default.key" \
    -out "$config_root/default.crt" >/dev/null 2>&1
  chmod 0600 "$config_root/default.key"
fi

backup="$(mktemp)"
had_config=false
if [[ -f "$nginx_config" ]]; then cp "$nginx_config" "$backup"; had_config=true; fi
default_link=/etc/nginx/sites-enabled/default
disabled_default=false
if [[ -L "$default_link" && "$(readlink -f "$default_link")" == /etc/nginx/sites-available/default ]]; then
  unlink "$default_link"
  disabled_default=true
fi

restore() {
  if [[ "$had_config" == true ]]; then
    install -m 0644 -o root -g root "$backup" "$nginx_config"
  else
    rm -f -- "$nginx_config"
  fi
  if [[ "$disabled_default" == true && ! -e "$default_link" ]]; then
    ln -s /etc/nginx/sites-available/default "$default_link"
  fi
  if [[ "$had_environment" == false ]]; then rm -f -- "$environment_file" "$email_file"; fi
}
trap 'restore; rm -f -- "$backup"' ERR
install -m 0644 -o root -g root "$ROOT_DIR/config/vps-gateway.conf" "$nginx_config"
nginx -t
if systemctl is-active --quiet nginx; then
  systemctl reload nginx
else
  systemctl enable --now nginx
fi
printf '%s\n' "$GATEWAY_TARGET" >"$environment_file"
printf '%s\n' "$email" >"$email_file"
chmod 0644 "$environment_file" "$email_file"
trap - ERR
rm -f -- "$backup"
echo "[gateway:$GATEWAY_TARGET] Host NGINX is ready on ports 80 and 443."
