#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/target.sh"
source "$ROOT_DIR/scripts/lib/routes.sh"
gateway_select_target "$@"
gateway_strip_target_arguments "$@"
set -- "${GATEWAY_REMAINING_ARGS[@]}"
gateway_require_root
gateway_require_installed_target
[[ $# -eq 3 ]] || {
  echo "usage: $0 [--test|--production] ROUTE_ID DOMAIN LOOPBACK_PORT" >&2
  exit 2
}
route_id="$1"; domain="$2"; port="$3"
gateway_validate_route_id "$route_id" || { echo '[gateway] Invalid route ID.' >&2; exit 2; }
gateway_validate_domain "$domain" || { echo '[gateway] Domain must be a lowercase FQDN.' >&2; exit 2; }
gateway_validate_port "$port" || { echo '[gateway] Port must be between 1024 and 65535.' >&2; exit 2; }

candidate="$(mktemp)"
trap 'rm -f -- "$candidate"' EXIT HUP INT TERM
exec 9>/run/lock/vps-gateway.lock
flock 9
route_path="/etc/vps-gateway/sites/$route_id.conf"
route_exists=false
if [[ -e "$route_path" || -L "$route_path" ]]; then
  [[ -f "$route_path" && ! -L "$route_path" ]] || {
    echo '[gateway] Existing route must be a regular file.' >&2
    exit 1
  }
  grep -Fqx "    server_name $domain;" "$route_path" || {
    echo '[gateway] This route ID already owns another domain; use a new ID.' >&2
    exit 1
  }
  route_exists=true
fi
for existing in /etc/vps-gateway/sites/*.conf; do
  [[ -f "$existing" ]] || continue
  [[ "$existing" == "$route_path" ]] && continue
  if grep -Fqx "    server_name $domain;" "$existing"; then
    echo "[gateway] Domain is already owned by $(basename "$existing" .conf)." >&2
    exit 1
  fi
done

if [[ "$route_exists" == false ]]; then
  gateway_render_route "$candidate" "$route_id" "$domain" "$port" false
  gateway_apply_route "$candidate" "$route_id"
fi

certbot_args=(certonly --webroot -w /var/www/letsencrypt --non-interactive \
  --agree-tos --no-eff-email --email "$(</etc/vps-gateway/letsencrypt-email)" \
  --cert-name "vps-$route_id" -d "$domain")
[[ "$GATEWAY_TARGET" == production ]] || certbot_args+=(--staging)
certbot "${certbot_args[@]}"

gateway_render_route "$candidate" "$route_id" "$domain" "$port" true
gateway_apply_route "$candidate" "$route_id"
echo "[gateway:$GATEWAY_TARGET] Connected https://$domain to 127.0.0.1:$port"
