#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/lib/target.sh"
gateway_select_runtime_target "$ROOT_DIR" "$@"
gateway_strip_target_arguments "$@"
set -- "${GATEWAY_REMAINING_ARGS[@]}"
gateway_load_runtime_config "$ROOT_DIR" "$GATEWAY_RUNTIME_CONFIG_FILE" "$GATEWAY_TARGET"

api_url="${GATEWAY_API_URL:-http://127.0.0.1:${GATEWAY_API_PORT}}"
auth="Authorization: Bearer $GATEWAY_API_TOKEN"
usage() {
  echo "usage: $0 [--test|--production] [--config FILE] list | get ID | apply ID JSON_FILE | delete ID | reload" >&2
  exit 2
}

command="${1:-}"
case "$command" in
  list)
    [[ $# -eq 1 ]] || usage
    exec curl --fail-with-body --silent --show-error -H "$auth" "$api_url/v1/routes"
    ;;
  get)
    [[ $# -eq 2 ]] || usage
    exec curl --fail-with-body --silent --show-error -H "$auth" "$api_url/v1/routes/$2"
    ;;
  apply)
    [[ $# -eq 3 && -f "$3" ]] || usage
    exec curl --fail-with-body --silent --show-error -X PUT -H "$auth" \
      -H 'Content-Type: application/json' --data-binary "@$3" "$api_url/v1/routes/$2"
    ;;
  delete)
    [[ $# -eq 2 ]] || usage
    exec curl --fail-with-body --silent --show-error -X DELETE -H "$auth" "$api_url/v1/routes/$2"
    ;;
  reload)
    [[ $# -eq 1 ]] || usage
    exec curl --fail-with-body --silent --show-error -X POST -H "$auth" "$api_url/v1/reload"
    ;;
  *) usage ;;
esac
